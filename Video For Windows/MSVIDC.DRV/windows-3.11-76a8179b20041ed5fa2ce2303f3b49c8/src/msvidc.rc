/*
 * msvidc.rc - resources reconstructed from MSVIDC.DRV
 * (RT_DIALOG "CONFIGURE", RT_STRING block 3, RT_VERSION 1)
 */

#include <windows.h>
#include <ver.h>
#include "msvidc.h"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION,    "Microsoft Video 1"
    IDS_NAME,           "MS-CRAM"
    IDS_ABOUT,          "About"
END

/* style 0x80C800C0 = WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_SETFONT */
CONFIGURE DIALOG 20, 24, 198, 85
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Configure"
FONT 8, "MS Sans Serif"
BEGIN
    CTEXT           "Microsoft Video 1 Compressor\nVersion 1.00\n\nCopyright \251 Microsoft Corp. 1990-1992\nPortions Copyright MediaVision Inc.",
                    -1, 0, 2, 198, 44, WS_GROUP
    DEFPUSHBUTTON   "OK", IDOK, 155, 53, 40, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 155, 68, 40, 14, WS_GROUP
    CONTROL         "", -1, "STATIC", SS_BLACKRECT | WS_VISIBLE | WS_CHILD, 1, 48, 197, 2
    LTEXT           "&Temporal Quality Ratio:", -1, 7, 55, 103, 8, WS_GROUP
    SCROLLBAR       ID_SCROLL, 7, 68, 140, 11, WS_GROUP
    RTEXT           "Text", ID_TEXT, 103, 55, 44, 10
END

/* VS_FIXEDFILEINFO in the binary has dwFileFlagsMask = 0x0030003F */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,10,0,176
PRODUCTVERSION  1,10,0,176
FILEFLAGSMASK   0x0030003FL
FILEFLAGS       0
FILEOS          VOS_DOS_WINDOWS16
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_INSTALLABLE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",        "Microsoft Corporation\0"
            VALUE "FileDescription",    "Microsoft Video 1 Compressor\0"
            VALUE "FileVersion",        "1.1\0"
            VALUE "InternalName",       "msvidc.drv\0"
            VALUE "LegalCopyright",     "Copyright \251 Microsoft Corp. 1992-1993\0"
            VALUE "OriginalFilename",   "msvidc.drv\0"
            VALUE "ProductName",        "Microsoft Video for Windows\0"
            VALUE "ProductVersion",     "1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
