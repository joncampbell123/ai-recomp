IDD_INITERROR DIALOG LOADONCALL MOVEABLE PURE DISCARDABLE 12, 28, 168, 196
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Initialization Error"
FONT 8, "Helv"
BEGIN
    CONTROL "Vidcap could not initialize the capture device.", 659, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 2, 6, 166, 12
    CONTROL "", IDC_INITERRTEXT, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 2, 20, 166, 16
    CONTROL "Checklist:", 660, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 2, 40, 166, 12
    CONTROL "Is the capture hardware properly configured?  Check the switch settings and jumpers on the capture device.", 661, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 10, 52, 154, 26
    CONTROL "Is a driver installed and configured?  Select the Drivers icon from the Control Panel to verify the presence of a capture driver.", 669, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 10, 82, 154, 28
    CONTROL "If you need to install a capture driver, choose the ""Add..."" button.", 671, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 20, 112, 146, 18
    CONTROL "If you need to configure a capture driver, choose the ""Setup..."" button.", 670, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 20, 132, 146, 18
    CONTROL "Do you wish to continue or exit?", 101, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 2, 158, 150, 10
    CONTROL "&Continue", IDC_CONTINUE, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 172, 40, 14
    CONTROL "E&xit", IDC_EXIT, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 92, 172, 40, 14
END

SETFILE DIALOG LOADONCALL MOVEABLE PURE DISCARDABLE 36, 24, 260, 140
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Set Capture File"
FONT 8, "Helv"
BEGIN
