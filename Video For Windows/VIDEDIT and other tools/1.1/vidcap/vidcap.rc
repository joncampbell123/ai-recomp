/*
 * vidcap.rc - resources reconstructed from VIDCAP.EXE
 *
 * The memory options are those of the binary.  The DLGINCLUDE resource
 * names the dialog editor's include file of the original source
 * (DLGIDS.H).  "\a" in the menus is the 0x08 that right-aligns the
 * accelerator text.  The menu items' IDs are also the IDs of their help
 * strings.
 */

#include <windows.h>
#include <ver.h>
#include <dlgs.h>
#include "vidcap.h"

VIDCAP ICON LOADONCALL MOVEABLE PURE DISCARDABLE "res/icon_vidcap.ico"

IDB_TOOLBAR BITMAP LOADONCALL MOVEABLE PURE "res/bitmap_100.bmp"

VIDCAP MENU LOADONCALL MOVEABLE PURE DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Palette...", IDM_LOADPALETTE
        MENUITEM "&Set Capture File...", IDM_SETCAPFILE
        MENUITEM SEPARATOR
        MENUITEM "Save &Captured Video As...", IDM_SAVEAS
        MENUITEM "Save &Palette...", IDM_SAVEPALETTE
        MENUITEM "Save Single &Frame...", IDM_SAVEFRAME
        MENUITEM SEPARATOR
        MENUITEM "&Edit Captured Video...", IDM_EDITCAPTURE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\aAlt+F4", IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\aCtrl+C", IDM_COPY
        MENUITEM "Paste &Palette", IDM_PASTEPALETTE
        MENUITEM SEPARATOR
        MENUITEM "Pre&ferences...", IDM_PREFERENCES
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Audio Format...", IDM_AUDIOFORMAT
        MENUITEM SEPARATOR
        MENUITEM "&Video Format...", IDM_VIDEOFORMAT
        MENUITEM "Video &Source...", IDM_VIDEOSOURCE
        MENUITEM "Video &Display...", IDM_VIDEODISPLAY
        MENUITEM SEPARATOR
        MENUITEM "Video &Compression...", IDM_COMPRESSION
        MENUITEM SEPARATOR
        MENUITEM "&Preview Video", IDM_PREVIEW
        MENUITEM "&Overlay Video", IDM_OVERLAY
    END
    POPUP "&Capture"
    BEGIN
        MENUITEM "&Single Frame", IDM_CAPSINGLE
        MENUITEM "&Frames...", IDM_CAPFRAMES
        MENUITEM "&Video...", IDM_CAPVIDEO
        MENUITEM "&Palette...", IDM_CAPPALETTE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents\aF1", IDM_HELPCONTENTS
        MENUITEM SEPARATOR
        MENUITEM "&About VidCap...", IDM_ABOUT
    END
END

VIDCAP ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
    "^C", IDM_COPY, ASCII
    VK_INSERT, IDM_COPY, VIRTKEY, CONTROL
    VK_F1, IDM_HELPCONTENTS, VIRTKEY
END

IDD_LEVELMONO DIALOG LOADONCALL MOVEABLE PURE DISCARDABLE 9, 28, 160, 70
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recording Level"
FONT 8, "helv"
BEGIN
    CONTROL "", IDC_METER1, "VCRLMeter", WS_CHILD | WS_VISIBLE | WS_DLGFRAME, 8, 8, 146, 14
    CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 60, 48, 40, 14
    CONTROL "Set the volume on your audio source.", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE, 8, 30, 146, 9
END

