VIDEDIT MENU PRELOAD MOVEABLE PURE DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", 11
        MENUITEM "&Open...\aCtrl+F12", 12
        MENUITEM "&Save\aShift+F12", 13
        MENUITEM "Save &As...\aF12", 14
        MENUITEM "&Revert", 15
        MENUITEM SEPARATOR
        MENUITEM "&Insert...", 16
        MENUITEM "&Extract...", 17
        MENUITEM SEPARATOR
        MENUITEM "&Capture Video...", 18
        MENUITEM "P&lay Preview", 19
        MENUITEM SEPARATOR
        MENUITEM "E&xit\aAlt+F4", 20
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\aCtrl+Z", 772
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\aCtrl+X", 768
        MENUITEM "&Copy\aCtrl+C", 769
        MENUITEM "&Paste\aCtrl+V", 770
        MENUITEM "Paste Pa&lette...", 30
        MENUITEM "&Delete", 31
        MENUITEM SEPARATOR
        MENUITEM "&Set Selection...", 38
        MENUITEM "&Go To...", 37
        POPUP "T&rack"
        BEGIN
            MENUITEM "&Video Only", 32
            MENUITEM "&Audio Only", 33
            MENUITEM "&Both Video && Audio", 34
        END
        MENUITEM SEPARATOR
        MENUITEM "Pre&ferences...", 36
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Full Frame Update", 50
        MENUITEM "F&ast Frame Update", 51
        MENUITEM SEPARATOR
        MENUITEM "&Draw Full Frame\aF5", 52
        POPUP "&Zoom"
        BEGIN
            MENUITEM "0.&5x", 45
            MENUITEM "&1x", 42
            MENUITEM "&2x", 43
            MENUITEM "&4x", 44
        END
    END
    POPUP "V&ideo"
    BEGIN
        MENUITEM "Compression &Options...", 60
        MENUITEM "Convert &Frame Rate...", 66
        MENUITEM "&Synchronize...", 63
        MENUITEM SEPARATOR
        MENUITEM "&Audio Format...", 68
        MENUITEM "&Video Format...", 69
        MENUITEM SEPARATOR
        MENUITEM "Create &Palette...", 64
        MENUITEM "&Crop...", 61
        MENUITEM "&Resize...", 62
        MENUITEM SEPARATOR
        MENUITEM "S&tatistics...", 67
        MENUITEM "&Load File into Memory", 65
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents\aF1", 71
        MENUITEM SEPARATOR
        MENUITEM "&About VidEdit...", 70
    END
END

VIDEDIT ACCELERATORS PRELOAD MOVEABLE PURE
BEGIN
    "^P", 80, ASCII
    "^Q", 81, ASCII
    "P", 81, VIRTKEY, ALT
    "P", 81, VIRTKEY, CONTROL, ALT
    "^S", 82, ASCII
    VK_ESCAPE, 82, VIRTKEY
    "^Z", 772, ASCII
    VK_DELETE, 31, VIRTKEY
    "^X", 768, ASCII
    "^C", 769, ASCII
    "^V", 770, ASCII
    VK_INSERT, 39, VIRTKEY
    VK_BACK, 772, VIRTKEY, ALT
    VK_DELETE, 768, VIRTKEY, SHIFT
    VK_INSERT, 769, VIRTKEY, CONTROL
    VK_INSERT, 770, VIRTKEY, SHIFT
    VK_F12, 12, VIRTKEY, CONTROL
    VK_F12, 14, VIRTKEY
    VK_F12, 13, VIRTKEY, SHIFT
    VK_F5, 52, VIRTKEY
    VK_F1, 71, VIRTKEY
END

